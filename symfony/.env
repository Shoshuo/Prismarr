# Prismarr — default values.
# Actual sensitive values (API keys) go in .env.local (never committed).

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=change_me_in_env_local
APP_SHARE_DIR=var/share
# Reverse-proxy support (Traefik, nginx, Caddy, Cloudflare Tunnel...).
# "REMOTE_ADDR" is a Symfony placeholder = trust the immediate upstream peer.
# Prismarr re-resolves it on EVERY request (TrustedProxiesSubscriber), so it
# also holds under FrankenPHP worker mode. Combined with 127.0.0.1 it covers
# local + docker-network reverse-proxies — but any client that reaches the
# port directly is then "its own proxy" and can forward a fake IP / scheme.
# Pin it to the proxy's IP or CIDR (or PRIVATE_SUBNETS) when the port is
# reachable from untrusted networks.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:7070
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite by default — zero-config, file in var/data/prismarr.db
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/prismarr.db"
###< doctrine/doctrine-bundle ###
###> symfony/mercure-bundle ###
MERCURE_URL=http://localhost:7070/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:7070/.well-known/mercure
MERCURE_JWT_SECRET=change_me_in_env_local
###< symfony/mercure-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

###> Prismarr UI ###
PRISMARR_PRIMARY_COLOR=#6366f1
PRISMARR_LOGO_URL=
###< Prismarr UI ###
