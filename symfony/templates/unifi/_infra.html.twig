{# Physical topology + RF. 60s cadence. One stat/device call feeds both the
   device table and the radio table; stat/rogueap and rest/networkconf feed the
   other two. Each panel owns its empty state, so one missing endpoint costs one
   panel, never the region.

   Styling note: the tabular-figure and chart classes used here live in a
   page-scoped <style> block in unifi/index.html.twig, not in this fragment —
   this file is re-injected on every 60s poll, so a <style> tag inside it would
   accumulate duplicates. #}
{% if infra is null %}
  <div class="card">
    <div class="card-body">
      <div class="empty">
        <p class="empty-title">{{ 'unifi.unreachable'|trans }}</p>
        <div class="empty-action">
          <button type="button" class="btn btn-primary" data-dash-retry>{{ 'unifi.retry'|trans }}</button>
        </div>
      </div>
    </div>
  </div>
{% else %}
<div class="row row-deck row-cards">

  {# ── Infrastructure ── #}
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">{{ 'unifi.infra.title'|trans }}</h3>
        <div class="card-subtitle ms-auto text-secondary small">
          {{ 'unifi.infra.summary'|trans({
               devices: infra.counts.devices,
               online: infra.counts.online,
               upgradable: infra.counts.upgradable
             }) }}
        </div>
      </div>
      {# One row per device rather than one card per device. These are homogeneous
         records with identical fields, so a table both compresses them (5 devices
         in ~200px instead of ~1100px) and makes the columns comparable — scanning
         "which box is hot?" down a RAM column is the actual job here. It also
         removes a nested-card level and matches the two RF tables below, so the
         whole region speaks one vocabulary. #}
      {% if infra.devices %}
        <div class="table-responsive">
          <table class="table table-sm table-vcenter card-table unifi-nums">
            <thead>
              <tr>
                <th>{{ 'unifi.infra.device'|trans }}</th>
                <th>IP</th>
                <th class="text-end">{{ 'unifi.tiles.clients'|trans }}</th>
                <th class="text-end">{{ 'unifi.infra.uptime'|trans }}</th>
                <th class="text-end">CPU</th>
                <th class="text-end">RAM</th>
                <th class="text-end">{{ 'unifi.infra.temperature'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for d in infra.devices %}
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <span class="status-dot {{ d.online ? 'status-dot-animated bg-green' : 'bg-red' }} me-2 flex-shrink-0"></span>
                      <div class="text-truncate">
                        <div class="text-truncate">{{ d.name ?? '—' }}</div>
                        {# Model and role on one muted sub-line: saves two columns
                           and keeps the row scannable at a glance. #}
                        <div class="text-secondary small text-truncate">
                          {{ d.model ?? '—' }} · {{ ('unifi.infra.kind_' ~ d.kind)|trans }}
                        </div>
                      </div>
                      {% if d.upgradable %}
                        <span class="badge bg-yellow-lt ms-2 flex-shrink-0">{{ 'unifi.infra.upgradable'|trans }}</span>
                      {% endif %}
                    </div>
                  </td>
                  <td class="font-monospace text-nowrap">{{ d.ip ?? '—' }}</td>
                  <td class="text-end">{{ d.clients ?? '—' }}</td>
                  <td class="text-end text-nowrap">{{ d.uptimeSeconds is null ? '—' : (d.uptimeSeconds // 86400) ~ 'd' }}</td>
                  {# Colour only when it's worth looking at — a quiet console
                     shouldn't render as a wall of green. #}
                  <td class="text-end {{ d.cpuPercent is not null and d.cpuPercent >= 80 ? 'text-red' : (d.cpuPercent is not null and d.cpuPercent >= 60 ? 'text-yellow' : '') }}">
                    {{ d.cpuPercent is null ? '—' : d.cpuPercent|round ~ '%' }}
                  </td>
                  <td class="text-end {{ d.memPercent is not null and d.memPercent >= 90 ? 'text-red' : (d.memPercent is not null and d.memPercent >= 80 ? 'text-yellow' : '') }}">
                    {{ d.memPercent is null ? '—' : d.memPercent|round ~ '%' }}
                  </td>
                  {# Gateway-only: no other device reports a temperature, so a
                     dash here is normal, not a failed read. #}
                  <td class="text-end text-nowrap">{{ d.tempC is null ? '—' : d.tempC|round ~ ' °C' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="card-body"><div class="empty"><p class="empty-title">{{ 'unifi.empty'|trans }}</p></div></div>
      {% endif %}
    </div>
  </div>

  {# ── RF environment: radios left, neighbors right ──
     7/5. An earlier 8/4 split clipped the neighbor table's Vendor column clean
     off at desktop width (live-verified): the reasoning was backwards, since the
     radio table had just LOST its satisfaction column and so needed less room,
     not more. 7 columns fit comfortably in 7, and 5 gives the neighbor table
     enough width for Vendor plus a non-wrapping `-60 dBm`. #}
  <div class="col-12 col-xl-7">
    <div class="card">
      <div class="card-header"><h3 class="card-title">{{ 'unifi.infra.radios'|trans }}</h3></div>
      {% if infra.radios %}
        <div class="table-responsive">
          <table class="table table-sm table-vcenter card-table unifi-nums">
            <thead>
              <tr>
                <th>{{ 'unifi.clients.access_point'|trans }}</th>
                <th>{{ 'unifi.clients.band'|trans }}</th>
                <th class="text-nowrap">{{ 'unifi.infra.channel'|trans }}</th>
                <th class="text-end text-nowrap">{{ 'unifi.infra.power'|trans }}</th>
                <th style="min-width:8rem">{{ 'unifi.infra.utilization'|trans }}</th>
                <th class="text-end">{{ 'unifi.infra.retry_pct'|trans }}</th>
                <th class="text-end">{{ 'unifi.tiles.clients'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for r in infra.radios %}
                <tr>
                  <td class="text-truncate">{{ r.device ?? '—' }}</td>
                  <td class="text-nowrap">{{ r.band }}</td>
                  <td class="text-nowrap">{{ r.channel ?? '—' }}{% if r.widthMhz %} <span class="text-secondary">/ {{ r.widthMhz }}</span>{% endif %}</td>
                  <td class="text-end text-nowrap">{{ r.txPowerDbm is null ? '—' : r.txPowerDbm ~ ' dBm' }}</td>
                  <td>
                    {% if r.utilizationPercent is null %}—{% else %}
                      <div class="d-flex align-items-center">
                        <div class="progress progress-sm flex-fill me-2">
                          <div class="progress-bar {{ r.utilizationPercent >= 70 ? 'bg-red' : (r.utilizationPercent >= 40 ? 'bg-yellow' : 'bg-green') }}"
                               style="width: {{ min(r.utilizationPercent, 100) }}%"></div>
                        </div>
                        <span class="text-secondary small text-nowrap">{{ r.utilizationPercent|round }}%</span>
                      </div>
                    {% endif %}
                  </td>
                  {# Retry is the one number here that's worth flagging: a radio
                     retransmitting a third of its frames is a real problem. #}
                  <td class="text-end {{ r.retryPercent is not null and r.retryPercent >= 25 ? 'text-red' : (r.retryPercent is not null and r.retryPercent >= 15 ? 'text-yellow' : '') }}">
                    {{ r.retryPercent is null ? '—' : r.retryPercent|round(1) ~ '%' }}
                  </td>
                  {# The Satisfaction column is deliberately gone. The console
                     reports -1 per radio on this firmware, so it was a permanently
                     empty column paying for itself in width on the widest table
                     of the page. UnifiInfraReader still maps `satisfaction`, so
                     restoring it means adding a th/td pair here plus a
                     `unifi.infra.satisfaction` key back to both locale files —
                     the key was removed with the column rather than left dead. #}
                  <td class="text-end">{{ r.clients ?? '—' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="card-body"><div class="empty"><p class="empty-title">{{ 'unifi.empty'|trans }}</p></div></div>
      {% endif %}
    </div>
  </div>

  <div class="col-12 col-xl-5">
    <div class="card">
      <div class="card-header"><h3 class="card-title">{{ 'unifi.infra.neighbors'|trans }}</h3></div>
      {% if infra.neighbors %}
        <div class="table-responsive" style="max-height: 22rem; overflow-y: auto">
          <table class="table table-sm table-vcenter card-table unifi-nums">
            <thead>
              <tr>
                <th>{{ 'unifi.clients.ssid'|trans }}</th>
                <th class="text-end">{{ 'unifi.infra.channel'|trans }}</th>
                <th class="text-end">{{ 'unifi.infra.signal'|trans }}</th>
                <th>{{ 'unifi.infra.vendor'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for n in infra.neighbors %}
                <tr>
                  {# A hidden network is a fact, not missing data — a bare dash
                     here reads as a failed parse, and half these rows are hidden. #}
                  <td class="text-truncate">
                    {%- if n.ssid is null -%}
                      <span class="text-secondary fst-italic">{{ 'unifi.infra.hidden_ssid'|trans }}</span>
                    {%- else -%}
                      {{ n.ssid }}
                    {%- endif -%}
                  </td>
                  <td class="text-end">{{ n.channel ?? '—' }}</td>
                  <td class="text-end text-nowrap">{{ n.signalDbm is null ? '—' : n.signalDbm ~ ' dBm' }}</td>
                  {# title= so a truncated vendor is still inspectable on hover. #}
                  <td class="text-secondary text-truncate" title="{{ n.vendor ?? '' }}">{{ n.vendor ?? '—' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        {# Expected state if stat/rogueap is unavailable on this firmware —
           see plan Task 5 Step 1b. Not a bug, so say why rather than showing
           a bare "no data". #}
        <div class="card-body">
          <div class="empty">
            <p class="empty-title">{{ 'unifi.infra.neighbors_unavailable'|trans }}</p>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  {# ── Networks / VLANs ── #}
  <div class="col-12">
    <div class="card">
      <div class="card-header"><h3 class="card-title">{{ 'unifi.infra.networks'|trans }}</h3></div>
      {% if infra.networks %}
        <div class="table-responsive">
          <table class="table table-sm table-vcenter card-table">
            <thead>
              <tr>
                <th>{{ 'unifi.infra.network_name'|trans }}</th>
                <th>{{ 'unifi.infra.vlan'|trans }}</th>
                <th>{{ 'unifi.infra.subnet'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for n in infra.networks %}
                <tr>
                  <td>{{ n.name ?? '—' }}</td>
                  {# No vlan id means the untagged/default network — a fact, not a
                     missing value, so say it rather than showing a bare dash. #}
                  <td>
                    {%- if n.vlan is null -%}
                      <span class="text-secondary fst-italic">{{ 'unifi.infra.untagged'|trans }}</span>
                    {%- else -%}
                      {{ n.vlan }}
                    {%- endif -%}
                  </td>
                  <td class="font-monospace">{{ n.subnet ?? '—' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="card-body"><div class="empty"><p class="empty-title">{{ 'unifi.empty'|trans }}</p></div></div>
      {% endif %}
    </div>
  </div>

</div>
{% endif %}
