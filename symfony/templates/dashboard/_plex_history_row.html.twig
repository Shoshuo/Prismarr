{# One watch-history row. Expects `h` (a normalized history row) with an integer
   `watchedAt` (Unix epoch seconds; 0/absent = unknown → time label omitted).
   Tracearr rows carry `posterServerId` and stream through its proxy; their
   `quickLook` {type, id} opens the app-global TMDb quick-look. #}
{% import '_icons.html.twig' as ico %}
{% set ql = h.quickLook|default(null) %}
<{{ ql ? 'a' : 'div' }} class="plex-session {% if h.ratingKey or ql %}plex-clickable{% endif %}{{ ql ? ' text-reset text-decoration-none' }}"
     {% if h.ratingKey %}data-plex-rating-key="{{ h.ratingKey }}" role="button" tabindex="0"{% endif %}
     {%- if ql %} href="{{ path('tmdb_index', {detail: ql.type ~ '/' ~ ql.id}) }}" data-ql-trigger data-ql-source="tmdb" data-ql-type="{{ ql.type }}" data-ql-id="{{ ql.id }}"{% endif %}>
  <div class="plex-poster">
    {{ ico.icon(h.mediaType == 'movie' ? 'movie' : 'device-tv', '', 22) }}
    {% if h.posterPath %}<img class="plex-poster-img" src="{{ h.posterServerId is defined ? path('app_tracearr_api_image', {server: h.posterServerId, img: h.posterPath}) : path('app_tautulli_api_image', {img: h.posterPath}) }}" alt="" loading="lazy">{% endif %}
  </div>
  <div class="plex-session-main">
    <div class="plex-session-title text-truncate">
      {% if h.mediaType == 'episode' and h.grandparentTitle %}{{ h.grandparentTitle }}{% if h.episodeCode %} <span class="plex-session-ep">{{ h.episodeCode }}</span>{% endif %}{% if h.title %} · {{ h.title }}{% endif %}{% else %}{{ h.title }}{% endif %}
      {% if h.year %}<span class="plex-session-year">({{ h.year }})</span>{% endif %}
    </div>
    <div class="plex-session-meta text-truncate">
      {{ [h.userDisplayName, h.watchedAt|relative_date]|filter(v => v is not null)|join(' · ') }}
    </div>
    {% if h.percentComplete > 0 %}
      <div class="progress plex-progress"><div class="progress-bar" style="width: {{ h.percentComplete }}%"></div></div>
    {% endif %}
  </div>
</{{ ql ? 'a' : 'div' }}>
