{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ico %}
{% block title %}{{ 'usenet.history.title'|trans }} — {{ client_label }}{% endblock %}
{% block page_title %}<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="{{ client == 'nzbget' ? '#1f9c3a' : '#ffa000' }}" stroke-width="2"><path d="M12 8v4l3 3"/><path d="M3.05 11a9 9 0 1 1 .5 4"/><path d="M3 4v5h5"/></svg> {{ client_label }} — {{ 'usenet.history.title'|trans }}{% endblock %}

{% block stylesheets %}
{% include 'usenet/_history_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="d-flex align-items-center mb-3">
  <a href="{{ path('app_usenet_index', {client: client}) }}" class="btn btn-sm btn-outline-secondary">
    {{ ico.icon('download', '', 14) }} {{ 'usenet.page_title'|trans }}
  </a>
  <span class="text-muted small ms-auto">{{ 'usenet.history.count'|trans({count: total}) }}</span>
</div>

{% if error %}
  {% include 'error/_service_banner.html.twig' with {service: client_label, wizard_route: 'app_setup_downloads', reason: 'unreachable'} %}
{% elseif items is empty %}
  <div class="card"><div class="card-body text-center text-muted py-5">{{ 'usenet.history.empty'|trans }}</div></div>
{% else %}
  <div class="uh-list">
    {% include 'usenet/_history_rows.html.twig' with {items: items, client: client} only %}
  </div>

  {% if total_pages > 1 %}
  <div class="d-flex align-items-center justify-content-center gap-3 mt-3">
    <a class="btn btn-sm btn-outline-secondary {{ page <= 1 ? 'disabled' }}"
       href="{{ path('app_usenet_history', {client: client, page: page - 1}) }}">{{ 'usenet.history.prev'|trans }}</a>
    <span class="text-muted small">{{ 'usenet.history.page_of'|trans({current: page, total: total_pages}) }}</span>
    <a class="btn btn-sm btn-outline-secondary {{ page >= total_pages ? 'disabled' }}"
       href="{{ path('app_usenet_history', {client: client, page: page + 1}) }}">{{ 'usenet.history.next'|trans }}</a>
  </div>
  {% endif %}
{% endif %}
{% endblock %}
