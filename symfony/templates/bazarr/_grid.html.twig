{#
  Shared Bazarr poster-grid (Movies + Series tabs). Renders Bazarr's OWN
  list (getMovies()/getSeries()) as a searchable, filterable, lazy-rendered
  poster-card grid, mirroring the library media-grid but SIMPLER: one poster
  (or a no-poster tile), the title, and one summary subtitle-status chip.

  Params:
    kind      : 'movie' | 'series' — series cards link to app_bazarr_series_detail;
                movie cards are display-only (movies have no drill-down route).
    cards     : list of { title, year, poster, substate, count, missingLangs, seriesId }
                (BazarrController::buildCards()). substate ∈ complete|missing|not-tracked.
    languages : distinct missing-language codes across the cards (Language filter options).

  The whole card set ships to the client as one JSON blob; the script below
  holds it, applies (search ∩ segment ∩ language) + sort over the FULL set,
  and renders a growing window (60/step) via an IntersectionObserver sentinel.
  Nothing is server-rendered into the grid — a 3k+ item table would be the very
  weight this replaces.

  poster-chip scrim is a page-local copy of the media-grid treatment
  (films.html.twig/series.html.twig own the canonical rule): opaque dark scrim +
  colored-text status so a same-hue poster can't wash the badge out.
#}
{% set is_series = kind == 'series' %}
<style>
.media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .75rem; }
.media-card {
  position: relative; display: block; border-radius: .5rem; overflow: hidden;
  background: var(--tblr-bg-surface); border: 1px solid var(--tblr-border-color);
  color: inherit; text-decoration: none;
  transition: transform .15s, box-shadow .15s;
}
a.media-card, .media-card[data-bazarr-search] { cursor: pointer; }
.media-card.is-static { cursor: default; }
.media-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.3); }
.media-card img { width: 100%; aspect-ratio: 2/3; object-fit: cover; display: block; }
.media-card .no-poster {
  width: 100%; aspect-ratio: 2/3;
  display: flex; align-items: center; justify-content: center;
  background: var(--tblr-bg-surface-secondary);
  color: var(--tblr-muted); font-size: .7rem; text-align: center; padding: .5rem;
}
.media-card .card-overlay {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,.85));
  padding: .5rem .4rem .4rem;
}
.media-card .card-title-text {
  font-size: .72rem; font-weight: 600; color: #fff;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.2;
}
.media-card .card-year { font-size: .62rem; color: rgba(255,255,255,.55); }
/* Locked .poster-chip scrim — mirrors films.html.twig/series.html.twig. */
.poster-chip { background: rgba(0,0,0,.65); backdrop-filter: blur(4px); color: #fff; font-size: .6875rem !important; }
.poster-chip.is-success { color: var(--tblr-success); }
.poster-chip.is-danger  { color: var(--tblr-danger); }
.poster-chip.is-warning { color: var(--tblr-warning); }
.poster-chip sup { font-size: 1em; }
.media-card .bazarr-chip { position: absolute; top: .4rem; left: .4rem; z-index: 2; padding: .1rem .4rem; border-radius: .25rem; }
/* Status segment pills. `--pill-hue` lets each pill tint its own active state. */
.filter-pill { border: 1px solid transparent; background: transparent; border-radius: 6px; padding: 4px 11px; font-size: .78rem; font-weight: 500; line-height: 1.3; color: var(--tblr-body-color); cursor: pointer; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; gap: .35rem; transition: background .12s ease, color .12s ease; }
.filter-pill:hover { background: rgba(var(--tblr-primary-rgb), .07); }
.filter-pill.active { font-weight: 600; background: color-mix(in srgb, var(--pill-hue, var(--tblr-primary)) 16%, transparent); color: var(--pill-hue, var(--tblr-primary)); }
/* Mobile/tablet readability floor: sub-11px text bumps to .6875rem
   below the lg breakpoint; desktop keeps the denser sizes. */
@media (max-width: 991.98px) {
  .media-card .card-year { font-size: .6875rem; }
}
</style>

<div class="card">
  <div class="card-header">
    <h3 class="card-title mb-0">{{ (is_series ? 'bazarr.series.title' : 'bazarr.movies.title')|trans }}</h3>
  </div>

  {% if cards is empty %}
    <div class="card-body">
      <div class="empty">
        <p class="empty-title">{{ (is_series ? 'bazarr.series.empty' : 'bazarr.movies.empty')|trans }}</p>
      </div>
    </div>
  {% else %}
    {# ── Filter bar (library-styled) ── #}
    <div class="card-body border-bottom py-2">
      <div class="d-flex flex-column gap-2">
        {# Row 1: title search + status segments #}
        <div class="d-flex align-items-center gap-2 flex-wrap flex-md-nowrap">
          <input type="search" id="bazarr-grid-search" class="form-control form-control-sm" style="max-width:220px"
                 placeholder="{{ 'bazarr.filter.search_placeholder'|trans }}" autocomplete="off"
                 aria-label="{{ 'bazarr.filter.search_placeholder'|trans }}">
          <div class="d-flex gap-1 flex-wrap flex-md-nowrap flex-fill" id="bazarr-grid-segments">
            {% for p in [
              { filter: 'all',         label: 'bazarr.filter.status_all'|trans,         hue: 'var(--tblr-secondary)' },
              { filter: 'complete',    label: 'bazarr.filter.status_complete'|trans,    hue: 'var(--tblr-success)' },
              { filter: 'missing',     label: 'bazarr.filter.status_missing'|trans,     hue: 'var(--tblr-warning)' },
              { filter: 'not-tracked', label: 'bazarr.filter.status_not_tracked'|trans, hue: 'var(--tblr-secondary)' }
            ] %}
              <button type="button" class="filter-pill flex-fill{{ p.filter == 'all' ? ' active' }}"
                      data-filter="{{ p.filter }}" style="--pill-hue:{{ p.hue }}">{{ p.label }}</button>
            {% endfor %}
          </div>
        </div>
        {# Row 2: language (only when the data carries missing-language codes) + sort #}
        <div class="d-flex align-items-center gap-2 flex-wrap flex-md-nowrap">
          {% if languages is not empty %}
            <select id="bazarr-grid-language" class="form-select form-select-sm" style="max-width:180px"
                    aria-label="{{ 'bazarr.filter.all_languages'|trans }}">
              <option value="">{{ 'bazarr.filter.all_languages'|trans }}</option>
              {% for code in languages %}
                <option value="{{ code }}">{{ code|upper }}</option>
              {% endfor %}
            </select>
          {% endif %}
          <select id="bazarr-grid-sort" class="form-select form-select-sm" style="max-width:200px"
                  aria-label="{{ 'bazarr.filter.sort_title_asc'|trans }}">
            <option value="title-asc">{{ 'bazarr.filter.sort_title_asc'|trans }}</option>
            <option value="missing-desc">{{ 'bazarr.filter.sort_missing_desc'|trans }}</option>
          </select>
        </div>
      </div>
    </div>

    {# ── Grid ── #}
    <div class="card-body">
      <div id="bazarr-grid" class="media-grid" data-kind="{{ kind }}"></div>
      <div id="bazarr-grid-empty" class="empty d-none">
        <p class="empty-title">{{ 'bazarr.grid.empty_filtered'|trans }}</p>
      </div>
      <div id="bazarr-grid-sentinel" aria-hidden="true" style="height:1px"></div>
    </div>

    <script>
    (function () {
      var grid = document.getElementById('bazarr-grid');
      if (!grid || grid._bazarrGridInit) return;
      grid._bazarrGridInit = true;

      var kind = grid.getAttribute('data-kind');
      // Full card set as a JS literal. The hex flags escape angle brackets,
      // ampersand and quotes to \uXXXX so nothing HTML-significant can break out
      // of this script element; the result is pure-ASCII JSON — a valid JS array.
      var all = {{ cards|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
      if (!Array.isArray(all)) { all = []; }

      var I18N = {
        complete:   {{ 'bazarr.grid.complete'|trans|json_encode|raw }},
        missing:    {{ 'bazarr.badge.missing'|trans|json_encode|raw }},
        notTracked: {{ 'bazarr.grid.not_tracked'|trans|json_encode|raw }}
      };

      var searchEl = document.getElementById('bazarr-grid-search');
      var langEl   = document.getElementById('bazarr-grid-language');
      var sortEl   = document.getElementById('bazarr-grid-sort');
      var segWrap  = document.getElementById('bazarr-grid-segments');
      var emptyEl  = document.getElementById('bazarr-grid-empty');
      var sentinel = document.getElementById('bazarr-grid-sentinel');

      var WINDOW = 60;
      var state = { q: '', segment: 'all', lang: '', sort: 'title-asc' };
      var filtered = [];
      var rendered = 0;

      function matches(c) {
        if (state.segment !== 'all' && c.substate !== state.segment) return false;
        if (state.lang && (c.missingLangs || []).indexOf(state.lang) === -1) return false;
        if (state.q && (c.title || '').toLowerCase().indexOf(state.q) === -1) return false;
        return true;
      }

      function renderChip(c) {
        if (c.substate === 'complete') {
          return '<span class="badge poster-chip is-success bazarr-chip" title="' + window.escHtml(I18N.complete) + '">' + window.escHtml(I18N.complete) + '</span>';
        }
        if (c.substate === 'missing') {
          var lbl = window.escHtml(I18N.missing) + ' ' + window.escHtml(String(c.count || 0));
          return '<span class="badge poster-chip is-warning bazarr-chip" title="' + lbl + '">' + lbl + '</span>';
        }
        return '<span class="badge poster-chip bazarr-chip" title="' + window.escHtml(I18N.notTracked) + '">' + window.escHtml(I18N.notTracked) + '</span>';
      }

      function buildCard(c) {
        var el;
        if (kind === 'series' && c.seriesId !== null && c.seriesId !== undefined) {
          el = document.createElement('a');
          el.href = '/bazarr/series/' + encodeURIComponent(c.seriesId);
          el.className = 'media-card';
          // The series-detail page is a separate full page, not one of the
          // views inside #bazarr-view — every link INTO the frame targets
          // it by id, but a link OUT of it must escape to the top level or
          // Turbo tries to satisfy the frame-scoped fetch by finding
          // id="bazarr-view" in the detail page's response, fails, and
          // replaces the Series tab with "Content missing".
          el.setAttribute('data-turbo-frame', '_top');
        } else if (kind === 'movie' && c.movieId !== null && c.movieId !== undefined) {
          // Clicking a movie card opens the shared subtitle-search modal for
          // that Radarr movie (search + download) — the capture-phase handler
          // in bazarr/_search_modal.html.twig services [data-bazarr-search].
          el = document.createElement('div');
          el.className = 'media-card';
          el.setAttribute('role', 'button');
          el.setAttribute('data-bazarr-search', '');
          el.setAttribute('data-kind', 'movie');
          el.setAttribute('data-id', String(c.movieId));
        } else {
          el = document.createElement('div');
          el.className = 'media-card is-static';
        }
        var title = window.escHtml(c.title || '');
        el.setAttribute('data-title', (c.title || '').toLowerCase());
        el.setAttribute('data-substate', c.substate || 'not-tracked');
        el.setAttribute('data-missing-langs', (c.missingLangs || []).join(','));
        el.setAttribute('data-count', String(c.count || 0));
        el.setAttribute('title', c.title || '');

        var poster = c.poster
          ? '<img src="' + window.escHtml(c.poster) + '" alt="' + title + '" loading="lazy">'
          : '<div class="no-poster">' + title + '</div>';
        var year = (c.year !== null && c.year !== undefined && c.year !== '')
          ? '<div class="card-year">' + window.escHtml(String(c.year)) + '</div>'
          : '';

        el.innerHTML = poster + renderChip(c)
          + '<div class="card-overlay"><div class="card-title-text">' + title + '</div>' + year + '</div>';
        return el;
      }

      function renderMore() {
        if (rendered >= filtered.length) return;
        var end = Math.min(rendered + WINDOW, filtered.length);
        var frag = document.createDocumentFragment();
        for (var i = rendered; i < end; i++) { frag.appendChild(buildCard(filtered[i])); }
        grid.appendChild(frag);
        rendered = end;
        // Re-arm the observer so a window that didn't fill the viewport keeps
        // loading (unobserve+observe forces a fresh intersection notification).
        if (io && sentinel && rendered < filtered.length) {
          io.unobserve(sentinel);
          io.observe(sentinel);
        }
      }

      function apply() {
        filtered = all.filter(matches);
        if (state.sort === 'missing-desc') {
          filtered.sort(function (a, b) {
            var d = (b.count || 0) - (a.count || 0);
            return d !== 0 ? d : (a.title || '').localeCompare(b.title || '');
          });
        } else {
          filtered.sort(function (a, b) { return (a.title || '').localeCompare(b.title || ''); });
        }
        grid.textContent = '';
        rendered = 0;
        if (emptyEl) { emptyEl.classList.toggle('d-none', filtered.length !== 0); }
        renderMore();
      }

      var io = null;
      if ('IntersectionObserver' in window && sentinel) {
        io = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) { if (entries[i].isIntersecting) { renderMore(); break; } }
        }, { root: null, rootMargin: '400px' });
        io.observe(sentinel);
      }

      var searchTimer = null;
      if (searchEl) {
        searchEl.addEventListener('input', function () {
          clearTimeout(searchTimer);
          searchTimer = setTimeout(function () {
            state.q = searchEl.value.trim().toLowerCase();
            apply();
          }, 150);
        });
      }
      if (langEl) { langEl.addEventListener('change', function () { state.lang = langEl.value; apply(); }); }
      if (sortEl) { sortEl.addEventListener('change', function () { state.sort = sortEl.value; apply(); }); }
      if (segWrap) {
        segWrap.addEventListener('click', function (e) {
          var btn = e.target && e.target.closest ? e.target.closest('.filter-pill') : null;
          if (!btn || !segWrap.contains(btn)) return;
          var f = btn.getAttribute('data-filter');
          if (!f || f === state.segment) return;
          state.segment = f;
          var pills = segWrap.querySelectorAll('.filter-pill');
          for (var i = 0; i < pills.length; i++) { pills[i].classList.toggle('active', pills[i] === btn); }
          apply();
        });
      }

      // Turbo re-executes body scripts on each visit; the fresh grid element's
      // one-shot flag makes re-init idempotent, and this teardown drops the
      // observer + timer so nothing leaks across navigations.
      //
      // Teardown must be dual-bound. A frame swap fires
      // turbo:before-frame-render on the frame element and NO document-level
      // turbo:before-render; a full-page Turbo Drive visit (direct hit,
      // History tab) fires only the latter. Removing both is idempotent.
      var frameEl = document.getElementById('bazarr-view');
      function teardown() {
        if (io) { io.disconnect(); io = null; }
        clearTimeout(searchTimer);
        if (frameEl) { frameEl.removeEventListener('turbo:before-frame-render', teardown); }
        document.removeEventListener('turbo:before-render', teardown);
      }
      if (frameEl) { frameEl.addEventListener('turbo:before-frame-render', teardown); }
      document.addEventListener('turbo:before-render', teardown);

      apply();
    })();
    </script>
  {% endif %}
</div>
