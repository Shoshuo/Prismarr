{% extends 'base.html.twig' %}

{% block title %}{{ 'bazarr.title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% endblock %}

{% block body %}
<div class="page-header d-print-none">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title">{{ 'bazarr.title'|trans }}</h2>
      <div class="text-secondary">{{ 'bazarr.subtitle'|trans }}</div>
    </div>
    <div class="col-auto ms-auto">
      {% include 'bazarr/_nav.html.twig' %}
    </div>
  </div>
</div>

<div class="page-body">
  <div class="container-xl">

    {% if error %}
      {% include 'error/_service_banner.html.twig' with { service: 'Bazarr', configured_url: service_url, reason: 'unreachable' } %}
    {% else %}
      {#
        One 50-row slice per card (BazarrController::HISTORY_PAGE_SIZE) — the
        full history is ~13k rows on a real install. Each card pages through
        its own query parameter; the other card's page is carried along so it
        stays where it was.
      #}
      {% set page_query = { movies_page: pages.movies, episodes_page: pages.episodes } %}
      <div class="row row-cards">
        {% for kind, card in cards %}
          {% set param = kind ~ '_page' %}
          <div class="col-lg-6">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">{{ ('bazarr.history.' ~ kind ~ '_title')|trans }}</h3>
              </div>
              {% if card.error %}
                <div class="card-body">
                  {% include 'error/_service_banner.html.twig' with { service: 'Bazarr', configured_url: service_url, reason: 'unreachable' } %}
                </div>
              {% elseif card.rows is empty %}
                <div class="card-body">
                  <div class="empty">
                    <p class="empty-title">{{ 'bazarr.history.empty'|trans }}</p>
                  </div>
                </div>
              {% else %}
                <div class="table-responsive">
                  <table class="table table-vcenter card-table">
                    <thead>
                      <tr>
                        <th>{{ 'bazarr.history.column_title'|trans }}</th>
                        <th>{{ 'bazarr.history.column_action'|trans }}</th>
                        <th>{{ 'bazarr.history.column_provider'|trans }}</th>
                        <th>{{ 'bazarr.history.column_language'|trans }}</th>
                        <th>{{ 'bazarr.history.column_date'|trans }}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for item in card.rows %}
                        <tr>
                          {% if kind == 'movies' %}
                            <td>{{ item.title|default('—') }}</td>
                          {% else %}
                            <td>{{ item.seriesTitle|default('—') }} — {{ item.episodeTitle|default('—') }} {% if item.episode_number is defined %}({{ item.episode_number }}){% endif %}</td>
                          {% endif %}
                          <td>{{ item.action|default('—') }}</td>
                          <td>{{ item.provider|default('—') }}</td>
                          <td>{% if item.language is iterable %}{{ item.language.name|default('—') }}{% else %}{{ item.language|default('—') }}{% endif %}</td>
                          <td>{{ item.raw_timestamp is defined and item.raw_timestamp ? item.raw_timestamp|relative_date : (item.parsed_timestamp|default(item.timestamp|default('—'))) }}</td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              {% endif %}
              {% if not card.error and card.total > 0 %}
                <div class="card-footer d-flex align-items-center gap-2">
                  <span class="text-secondary small">{{ 'bazarr.history.range'|trans({ from: card.rows is empty ? 0 : card.from, to: card.to, total: card.total|number_format }) }}</span>
                  <span class="flex-fill"></span>
                  {% if card.page > 1 %}
                    <a class="btn btn-sm btn-ghost-secondary" href="{{ path('app_bazarr_history', page_query|merge({ (param): card.page - 1 })) }}">{{ 'bazarr.history.newer'|trans }}</a>
                  {% endif %}
                  {% if card.page * page_size < card.total %}
                    <a class="btn btn-sm btn-ghost-secondary" href="{{ path('app_bazarr_history', page_query|merge({ (param): card.page + 1 })) }}">{{ 'bazarr.history.older'|trans }}</a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>
{% endblock %}
